DB_HOST=localhost
DB_PORT=3306
DB_USER=wallet_user
DB_PASSWORD=your_password_here
DB_NAME=digital_wallet

# 32-byte master key for AES-256-GCM private key encryption (required)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KMS_MASTER_KEY=

# Admin service API key (required for admin/ service)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Set after running node db/migrate.js (printed by migration script)
DEFAULT_CLIENT_ID=default-client
DEFAULT_API_KEY=
DEFAULT_TENANT_ID=1

# Public base URLs for each service (used in credentials, metadata, QR codes)
ISSUER_BASE_URL=http://localhost:3001
HOLDER_BASE_URL=http://localhost:3002
VERIFIER_BASE_URL=http://localhost:3003
DEMO_BASE_URL=http://localhost:3004
REGISTRY_BASE_URL=http://localhost:3005

# Optional port overrides (defaults shown)
# ADMIN_PORT=3000
# ISSUER_PORT=3001
# HOLDER_PORT=3002
# VERIFIER_PORT=3003
# DEMO_PORT=3004
# REGISTRY_PORT=3005
