                </mxCell>
                <mxCell id="hdrGrpInt" value="1. INTERNAL — this wallet&#39;s own infrastructure (full visibility / control)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="925" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="hdrGrpExt" value="2. EXTERNAL — the QVI&#39;s own infrastructure (opaque to us; only the KERI protocol surface is visible)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dddddd;strokeColor=#666666;strokeWidth=2;dashed=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="980" y="80" width="455" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="hdr1a" value="1a. KERI&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;shared/keri-client.js, keri-issue-flow.js, keri-trust-chain.js — this wallet&#39;s own protocol library&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="120" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="hdr1b" value="1b. Witness&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Docker container &#39;witness&#39; (keypair &#39;wan&#39;) — receipts/anchors this wallet&#39;s KEL &amp; TEL events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="275" y="120" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="hdr1c" value="1c. Holder Service (Person)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;holder/server.js + holder/keri.js, keriRole=&#39;person&#39;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="510" y="120" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="hdr1d" value="1d. Verifier Service&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;verifier/server.js + verifier/keri.js&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="745" y="120" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="hdr2a" value="2a. KERI&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;the External QVI&#39;s own KERI stack — referenced here only for the trust-chain root, no direct calls this page&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;dashed=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="980" y="120" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="hdr2b" value="2b. Witness&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;the External QVI&#39;s own witness network — already receipted the ancestor credentials in earlier pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1215" y="120" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s1_ver" value="&lt;b&gt;1. Create Verifier AID&lt;/b&gt;&lt;br&gt;POST /verifier/keri/create&lt;br&gt;{name}&lt;br&gt;&lt;br&gt;createKeriAid()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeeee;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="745" y="210" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s1_keri" value="&lt;b&gt;createAid(client,alias)&lt;/b&gt;&lt;br&gt;→ identifiers().create(name)&lt;br&gt;→ addEndRole(&#39;agent&#39;)&lt;br&gt;→ oobis().get(&#39;agent&#39;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e9;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="210" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s1_wit" value="Witness &#39;wan&#39; receipts Verifier&#39;s inception (icp) event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf3ff;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="275" y="210" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s2_person" value="&lt;b&gt;2. Person Presents oor-cred&lt;/b&gt;&lt;br&gt;POST /holder/keri/present&lt;br&gt;{identityId, credentialSaid,&lt;br&gt;verifierAidPrefix, verifierOobi}&lt;br&gt;&lt;br&gt;presentCredential()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffae6;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="510" y="410" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s2_keri" value="&lt;b&gt;resolveOobi(verifierOobi)&lt;/b&gt;&lt;br&gt;→ &lt;b&gt;serdersFromCredential()&lt;/b&gt;&lt;br&gt;rebuilds acdc/anc/iss Serders&lt;br&gt;→ &lt;b&gt;ipexGrant()&lt;/b&gt; re-grants&lt;br&gt;the held ACDC onward" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e9;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="410" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s2_wit" value="No witness action — presentation grant is an exn message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf3ff;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="275" y="410" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s2_ver" value="&lt;i&gt;Presentation grant arrives in Verifier&#39;s KERIA mailbox&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fdeeee;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="745" y="410" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s3_ver" value="&lt;b&gt;3. Verifier Resolves Sender&lt;/b&gt;&lt;br&gt;POST /verifier/keri/resolve-sender&lt;br&gt;{fromAidPrefix:PERSON_AID,&lt;br&gt;fromOobi}&lt;br&gt;&lt;br&gt;resolveSenderOobi()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeeee;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="745" y="610" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s3_keri" value="&lt;b&gt;resolveOobi(client,&lt;br&gt;fromOobi,&#39;sender-...&#39;)&lt;/b&gt;&lt;br&gt;caches Person&#39;s key state&lt;br&gt;&lt;br&gt;&lt;i&gt;must run BEFORE admit, else&lt;br&gt;KERIA escrows + crashes on&lt;br&gt;unknown sender&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e9;strokeColor=#9673a6;fontSize=9;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="610" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s3_wit" value="N/A — key-state query only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf3ff;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="275" y="610" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s4_ver" value="&lt;b&gt;4. Verifier Admits &amp; Verifies&lt;/b&gt;&lt;br&gt;POST /verifier/keri/admit&lt;br&gt;{grantSaid, credentialSaid}&lt;br&gt;&lt;br&gt;admitAndVerify()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeeee;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="745" y="810" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s4_keri" value="&lt;b&gt;admitAndStoreAcdc()&lt;/b&gt;&lt;br&gt;→ ipexAdmit()+credentials().get()&lt;br&gt;&lt;br&gt;&lt;b&gt;verifyAcdcChain(said,&lt;br&gt;TRUSTED_ROOT_AID_PREFIXES)&lt;/b&gt;&lt;br&gt;keri-trust-chain.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e9;strokeColor=#9673a6;fontSize=9;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="810" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s4_wit" value="No witness action for the admit itself — chain walk reads each ancestor&#39;s already-witnessed TEL data (replayed locally)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf3ff;strokeColor=#6c8ebf;fontSize=9;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="275" y="810" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s4_qvi" value="Chain walk confirms each issuer AID at every edge hop:&lt;br&gt;oor-cred ← oor-auth-cred ← le-cred ← qvi-cred ← GEDA&lt;br&gt;(root in TRUSTED_ROOT_AID_PREFIXES)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e9;strokeColor=#9673a6;strokeWidth=2;dashed=1;fontSize=9;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="980" y="810" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="result" value="&lt;b&gt;Result:&lt;/b&gt; Trust chain fully verified — LEI (Legal Entity) and Official Role (Person) both accepted by the Verifier. Root of trust: GEDA (process.env.GEDA_AID_PREFIX / TRUSTED_ROOT_AID_PREFIXES)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1000" width="1395" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="legendA" value="&lt;b&gt;Acronym Glossary (1/2) — Core KERI Concepts&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;AID&lt;/b&gt; — Autonomic Identifier: KERI&#39;s self-certifying identifier (the actual &#39;identity&#39;)&lt;br&gt;&lt;b&gt;KERI&lt;/b&gt; — Key Event Receipt Infrastructure: the protocol itself&lt;br&gt;&lt;b&gt;KERIA&lt;/b&gt; — KERI Agent: the server-side agent signify-ts talks to&lt;br&gt;&lt;b&gt;KEL&lt;/b&gt; — Key Event Log: an AID&#39;s history of key-state changes (icp, rot...)&lt;br&gt;&lt;b&gt;TEL&lt;/b&gt; — Transaction Event Log: a registry&#39;s history of credential issuance/revocation (vcp, iss, rev...)&lt;br&gt;&lt;b&gt;OOBI&lt;/b&gt; — Out-Of-Band Introduction: a URL used to discover/resolve an AID&#39;s keys &amp; endpoint&lt;br&gt;&lt;b&gt;SAID&lt;/b&gt; — Self-Addressing Identifier: a content-hash identifier (credentials, schemas, edges)&lt;br&gt;&lt;b&gt;toad&lt;/b&gt; — Threshold Of Accountable Duplicity: witness receipts required before an event is accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1100" width="665" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="legendB" value="&lt;b&gt;Acronym Glossary (2/2) — Credentials &amp; vLEI Domain&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ACDC&lt;/b&gt; — Authentic Chained Data Container: KERI&#39;s credential format&lt;br&gt;&lt;b&gt;IPEX&lt;/b&gt; — Issuance and Presentation Exchange: protocol for grant/admit (and apply/offer)&lt;br&gt;&lt;b&gt;exn&lt;/b&gt; — Exchange message: the peer-to-peer message type IPEX grant/admit are built on&lt;br&gt;&lt;b&gt;icp / iss&lt;/b&gt; — Inception event (first KEL event) / Issuance event (first TEL event)&lt;br&gt;&lt;b&gt;LEI&lt;/b&gt; — Legal Entity Identifier: the 20-character GLEIF code identifying an organization&lt;br&gt;&lt;b&gt;vLEI&lt;/b&gt; — verifiable LEI: the ACDC-based digital credential representing an LEI&lt;br&gt;&lt;b&gt;QVI&lt;/b&gt; — Qualified vLEI Issuer: GLEIF-accredited org authorized to issue vLEI credentials&lt;br&gt;&lt;b&gt;LE&lt;/b&gt; — Legal Entity: the organization holding the LEI/vLEI&lt;br&gt;&lt;b&gt;GEDA&lt;/b&gt; — GLEIF External Delegated AID: root-of-trust AID representing GLEIF in this demo&lt;br&gt;&lt;b&gt;OOR / ECR&lt;/b&gt; — Official Organizational Role / Engagement Context Role: person-level role credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="730" y="1100" width="665" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="e1a" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="s1_ver" target="s1_keri" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e1b" value="icp event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s1_keri" target="s1_wit" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2a" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="s2_person" target="s2_keri" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2b" value="n/a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s2_keri" target="s2_wit" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2c" value="IPEX grant delivered" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=9;endArrow=block;strokeColor=#b85450;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s2_person" target="s2_ver" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3a" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="s3_ver" target="s3_keri" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3b" value="n/a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3_keri" target="s3_wit" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4a" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="s4_ver" target="s4_keri" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4b" value="reads TEL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s4_keri" target="s4_wit" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4c" value="walks edge chain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#82b366;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s4_keri" target="s4_qvi" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="seq1" value="Verifier AID ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s1_ver" target="s2_person" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="seq2" value="Verifier picks up grant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s2_ver" target="s3_ver" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="seq3" value="sender key state cached" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s3_ver" target="s4_ver" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
