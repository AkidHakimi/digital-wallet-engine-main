                <mxCell id="bgWitInt" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=none;opacity=10;" parent="1" vertex="1">
                    <mxGeometry x="275" y="80" width="220" height="1010" as="geometry"/>
                </mxCell>
                <mxCell id="bgLeSvc" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=none;opacity=10;" parent="1" vertex="1">
                    <mxGeometry x="510" y="80" width="220" height="1010" as="geometry"/>
                </mxCell>
                <mxCell id="bgKeriExt" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=none;opacity=18;" parent="1" vertex="1">
                    <mxGeometry x="745" y="80" width="220" height="1010" as="geometry"/>
                </mxCell>
                <mxCell id="bgWitExt" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=none;opacity=18;" parent="1" vertex="1">
                    <mxGeometry x="980" y="80" width="220" height="1010" as="geometry"/>
                </mxCell>
                <mxCell id="hdrGrpInt" value="1. INTERNAL — this wallet&#39;s own infrastructure (full visibility / control)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="690" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="hdrGrpExt" value="2. EXTERNAL — the QVI&#39;s own infrastructure (opaque to us; only the KERI protocol surface is visible)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dddddd;strokeColor=#666666;strokeWidth=2;dashed=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="745" y="80" width="455" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="hdr1a" value="1a. KERI&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;shared/keri-client.js, keri-issue-flow.js — this wallet&#39;s own protocol library&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="120" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="hdr1b" value="1b. Witness&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Docker container &#39;witness&#39; (keypair &#39;wan&#39;) — receipts/anchors this wallet&#39;s KEL &amp; TEL events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="275" y="120" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="hdr1c" value="1c. Holder Service (Legal Entity)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;holder/server.js + holder/keri.js, keriRole=&#39;le&#39;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="510" y="120" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="hdr2a" value="2a. KERI&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;the External QVI&#39;s own KERI stack — in this demo, simulated by the same shared/keri-client.js via issuer/keri.js&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;dashed=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="745" y="120" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="hdr2b" value="2b. Witness&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;the External QVI&#39;s own witness network — in this demo, the same shared witness container&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="980" y="120" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s1_le" value="&lt;b&gt;1. Create LE AID&lt;/b&gt;&lt;br&gt;POST /holder/keri/create&lt;br&gt;{keriRole:&#39;le&#39;, name,&lt;br&gt;qviAid, qviOobi}&lt;br&gt;&lt;br&gt;createKeriAid()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="510" y="210" width="220" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s1_keri" value="&lt;b&gt;createAid(client,alias)&lt;/b&gt;&lt;br&gt;→ identifiers().create(name)&lt;br&gt;→ addEndRole(&#39;agent&#39;)&lt;br&gt;→ oobis().get(&#39;agent&#39;)&lt;br&gt;&lt;br&gt;&lt;b&gt;resolveOobi(qviOobi)&lt;/b&gt;&lt;br&gt;caches QVI&#39;s key state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e9;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="210" width="220" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s1_wit" value="Witness &#39;wan&#39; receipts LE&#39;s inception (icp) event&lt;br&gt;&lt;br&gt;Anchors LE&#39;s KEL&lt;br&gt;(toad=1 satisfied)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf3ff;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="275" y="210" width="220" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s2_qvi" value="&lt;b&gt;2. QVI Issues le-cred + Grants&lt;/b&gt;&lt;br&gt;POST /issuer/keri/issue {holderPrefix:LE_AID, schemaSaid:LE_SCHEMA_SAID, subject:{LEI}}&lt;br&gt;&lt;br&gt;&lt;b&gt;issueCredentialToHolder() → issueAndGrantAcdc()&lt;/b&gt;&lt;br&gt;→ ensureSchemaResolved()&lt;br&gt;→ resolveOobi(holderOobi)&lt;br&gt;→ issueAcdc() — credentials().issue()&lt;br&gt;→ ipexGrant() — ipex().grant()+submitGrant()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e9;strokeColor=#9673a6;strokeWidth=2;dashed=1;fontSize=9;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="745" y="400" width="220" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s2_wit" value="Witness receipts the TEL &lt;b&gt;iss&lt;/b&gt; event in QVI&#39;s registry&lt;br&gt;(le-cred recorded in QVI&#39;s TEL)&lt;br&gt;&lt;br&gt;&lt;i&gt;IPEX grant (exn) is NOT witnessed — delivered via KERIA mailbox&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf3ff;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="980" y="400" width="220" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s2_le" value="&lt;i&gt;le-cred grant arrives in LE&#39;s KERIA mailbox&lt;/i&gt;&lt;br&gt;(notifications().list())" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="510" y="400" width="220" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s3_le" value="&lt;b&gt;3. LE Admits le-cred&lt;/b&gt;&lt;br&gt;POST /holder/keri/admit&lt;br&gt;{fromAidPrefix:QVI_AID,&lt;br&gt;grantSaid, credentialSaid}&lt;br&gt;&lt;br&gt;admitGrant()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="510" y="590" width="220" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s3_keri" value="&lt;b&gt;admitAndStoreAcdc()&lt;/b&gt;&lt;br&gt;→ resolveOobi(fromOobi)&lt;br&gt;&amp;nbsp;&amp;nbsp;(first admit from this sender)&lt;br&gt;→ ipexAdmit()&lt;br&gt;&amp;nbsp;&amp;nbsp;ipex().admit()+submitAdmit()&lt;br&gt;→ credentials().get()&lt;br&gt;&amp;nbsp;&amp;nbsp;(retried up to 30s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e9;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="590" width="220" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s3_wit" value="No witness action — IPEX admit is an exn exchange, not a KEL/TEL event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf3ff;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="275" y="590" width="220" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="result" value="&lt;b&gt;Result:&lt;/b&gt; Legal Entity now holds a verifiable le-cred (the LEI), edge-chained to QVI&#39;s qvi-cred. Schema: le-cred — shared/keri/schemas/definitions.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="770" width="1160" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="legendA" value="&lt;b&gt;Acronym Glossary (1/2) — Core KERI Concepts&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;AID&lt;/b&gt; — Autonomic Identifier: KERI&#39;s self-certifying identifier (the actual &#39;identity&#39;)&lt;br&gt;&lt;b&gt;KERI&lt;/b&gt; — Key Event Receipt Infrastructure: the protocol itself&lt;br&gt;&lt;b&gt;KERIA&lt;/b&gt; — KERI Agent: the server-side agent signify-ts talks to&lt;br&gt;&lt;b&gt;KEL&lt;/b&gt; — Key Event Log: an AID&#39;s history of key-state changes (icp, rot...)&lt;br&gt;&lt;b&gt;TEL&lt;/b&gt; — Transaction Event Log: a registry&#39;s history of credential issuance/revocation (vcp, iss, rev...)&lt;br&gt;&lt;b&gt;OOBI&lt;/b&gt; — Out-Of-Band Introduction: a URL used to discover/resolve an AID&#39;s keys &amp; endpoint&lt;br&gt;&lt;b&gt;SAID&lt;/b&gt; — Self-Addressing Identifier: a content-hash identifier (credentials, schemas, edges)&lt;br&gt;&lt;b&gt;toad&lt;/b&gt; — Threshold Of Accountable Duplicity: witness receipts required before an event is accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="860" width="570" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="legendB" value="&lt;b&gt;Acronym Glossary (2/2) — Credentials &amp; vLEI Domain&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ACDC&lt;/b&gt; — Authentic Chained Data Container: KERI&#39;s credential format&lt;br&gt;&lt;b&gt;IPEX&lt;/b&gt; — Issuance and Presentation Exchange: protocol for grant/admit (and apply/offer)&lt;br&gt;&lt;b&gt;exn&lt;/b&gt; — Exchange message: the peer-to-peer message type IPEX grant/admit are built on&lt;br&gt;&lt;b&gt;icp / iss&lt;/b&gt; — Inception event (first KEL event) / Issuance event (first TEL event)&lt;br&gt;&lt;b&gt;LEI&lt;/b&gt; — Legal Entity Identifier: the 20-character GLEIF code identifying an organization&lt;br&gt;&lt;b&gt;vLEI&lt;/b&gt; — verifiable LEI: the ACDC-based digital credential representing an LEI&lt;br&gt;&lt;b&gt;QVI&lt;/b&gt; — Qualified vLEI Issuer: GLEIF-accredited org authorized to issue vLEI credentials&lt;br&gt;&lt;b&gt;LE&lt;/b&gt; — Legal Entity: the organization holding the LEI/vLEI&lt;br&gt;&lt;b&gt;GEDA&lt;/b&gt; — GLEIF External Delegated AID: root-of-trust AID representing GLEIF in this demo&lt;br&gt;&lt;b&gt;OOR / ECR&lt;/b&gt; — Official Organizational Role / Engagement Context Role: person-level role credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="630" y="860" width="570" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="e1a" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="s1_le" target="s1_keri" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e1b" value="icp event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s1_keri" target="s1_wit" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2b" value="iss event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s2_qvi" target="s2_wit" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2c" value="IPEX grant delivered" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=9;endArrow=block;strokeColor=#82b366;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s2_qvi" target="s2_le" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3a" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="s3_le" target="s3_keri" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3b" value="n/a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3_keri" target="s3_wit" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="seq1" value="LE ready; QVI&#39;s OOBI known" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s1_le" target="s2_qvi" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="seq2" value="LE picks up grant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s2_le" target="s3_le" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
