                <mxCell id="hdr2a" value="2a. KERI&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;the External QVI&#39;s own KERI stack — in this demo, simulated by the same shared/keri-client.js via issuer/keri.js&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;dashed=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="980" y="120" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="hdr2b" value="2b. Witness&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;the External QVI&#39;s own witness network — in this demo, the same shared witness container&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1215" y="120" width="220" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s1_person" value="&lt;b&gt;1. Create Person AID&lt;/b&gt;&lt;br&gt;POST /holder/keri/create&lt;br&gt;{keriRole:&#39;person&#39;, name,&lt;br&gt;qviAid, qviOobi}&lt;br&gt;&lt;br&gt;createKeriAid()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffae6;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="745" y="210" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s1_keri" value="&lt;b&gt;createAid(client,alias)&lt;/b&gt;&lt;br&gt;→ identifiers().create(name)&lt;br&gt;→ addEndRole(&#39;agent&#39;)&lt;br&gt;&lt;br&gt;&lt;b&gt;resolveOobi(qviOobi)&lt;/b&gt;&lt;br&gt;caches QVI&#39;s key state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e9;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="210" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s1_wit" value="Witness &#39;wan&#39; receipts Person&#39;s inception (icp) event&lt;br&gt;&lt;br&gt;Anchors Person&#39;s KEL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf3ff;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="275" y="210" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s2_le" value="&lt;b&gt;2. Create LE TEL Registry&lt;/b&gt;&lt;br&gt;POST /holder/keri/registry&lt;br&gt;{keriRole:&#39;le&#39;, identityId}&lt;br&gt;&lt;br&gt;createKeriRegistry()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="510" y="410" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s2_keri" value="&lt;b&gt;createRegistry(client,&lt;br&gt;alias,&#39;le-registry&#39;)&lt;/b&gt;&lt;br&gt;→ registries().list()&lt;br&gt;→ registries().create(&lt;br&gt;{name,registryName})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e9;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="410" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s2_wit" value="Witness receipts the registry inception (&lt;b&gt;vcp&lt;/b&gt;) event — anchors LE&#39;s TEL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf3ff;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="275" y="410" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s3_le" value="&lt;b&gt;3. LE Issues oor-auth-cred&lt;/b&gt;&lt;br&gt;POST /holder/keri/issue&lt;br&gt;{holderPrefix:QVI_AID,&lt;br&gt;schemaSaid:OOR_AUTH_SAID,&lt;br&gt;subject:{AID,personLegalName,&lt;br&gt;officialRole}, edge:{le:LE_CRED_SAID}}&lt;br&gt;issueCredentialToHolder()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=9;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="510" y="610" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s3_keri" value="&lt;b&gt;issueAndGrantAcdc()&lt;/b&gt;&lt;br&gt;→ issueAcdc()&lt;br&gt;&amp;nbsp;&amp;nbsp;credentials().issue()&lt;br&gt;&amp;nbsp;&amp;nbsp;(TEL iss, edge→le-cred)&lt;br&gt;→ ipexGrant() to QVI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e9;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="610" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s3_wit" value="Witness receipts the TEL &lt;b&gt;iss&lt;/b&gt; event in LE&#39;s registry&lt;br&gt;(oor-auth-cred recorded)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf3ff;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="275" y="610" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s3_qvi" value="&lt;i&gt;oor-auth-cred grant arrives in QVI&#39;s KERIA mailbox&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#eaf7e9;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="980" y="610" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s4_qvi" value="&lt;b&gt;4. QVI Admits oor-auth-cred&lt;/b&gt;&lt;br&gt;POST /issuer/keri/admit {fromAidPrefix:LE_AID, grantSaid, credentialSaid}&lt;br&gt;&lt;br&gt;&lt;b&gt;admitGrant() → admitAndStoreAcdc()&lt;/b&gt;&lt;br&gt;→ ipexAdmit() → credentials().get()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e9;strokeColor=#9673a6;strokeWidth=2;dashed=1;fontSize=9;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="980" y="810" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s4_wit" value="No witness action — IPEX admit is an exn exchange" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf3ff;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="1215" y="810" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s5_qvi" value="&lt;b&gt;5. QVI Issues oor-cred&lt;/b&gt;&lt;br&gt;POST /issuer/keri/issue {holderPrefix:PERSON_AID, schemaSaid:OOR_SAID, subject:{personLegalName, officialRole}, edge:{oorAuth:OOR_AUTH_SAID}}&lt;br&gt;&lt;br&gt;&lt;b&gt;issueAndGrantAcdc()&lt;/b&gt; → issueAcdc() (TEL iss, edge→oor-auth-cred) → ipexGrant() to Person" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e9;strokeColor=#9673a6;strokeWidth=2;dashed=1;fontSize=9;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="980" y="1010" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s5_wit" value="Witness receipts the TEL &lt;b&gt;iss&lt;/b&gt; event in QVI&#39;s registry&lt;br&gt;(oor-cred recorded)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf3ff;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="1215" y="1010" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s5_person" value="&lt;i&gt;oor-cred grant arrives in Person&#39;s KERIA mailbox&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffae6;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="745" y="1010" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s6_person" value="&lt;b&gt;6. Person Admits oor-cred&lt;/b&gt;&lt;br&gt;POST /holder/keri/admit&lt;br&gt;{fromAidPrefix:QVI_AID,&lt;br&gt;grantSaid, credentialSaid}&lt;br&gt;&lt;br&gt;admitGrant()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffae6;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="745" y="1210" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s6_keri" value="&lt;b&gt;admitAndStoreAcdc()&lt;/b&gt;&lt;br&gt;→ ipexAdmit()&lt;br&gt;&amp;nbsp;&amp;nbsp;ipex().admit()+submitAdmit()&lt;br&gt;→ credentials().get()&lt;br&gt;&amp;nbsp;&amp;nbsp;(retry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7e9;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1210" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s6_wit" value="No witness action — IPEX admit is an exn exchange" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ebf3ff;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
                    <mxGeometry x="275" y="1210" width="220" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="result" value="&lt;b&gt;Result:&lt;/b&gt; Person now holds oor-cred (Official Organizational Role). Edge chain: oor-cred → oor-auth-cred → le-cred → qvi-cred → GEDA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1400" width="1395" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="legendA" value="&lt;b&gt;Acronym Glossary (1/2) — Core KERI Concepts&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;AID&lt;/b&gt; — Autonomic Identifier: KERI&#39;s self-certifying identifier (the actual &#39;identity&#39;)&lt;br&gt;&lt;b&gt;KERI&lt;/b&gt; — Key Event Receipt Infrastructure: the protocol itself&lt;br&gt;&lt;b&gt;KERIA&lt;/b&gt; — KERI Agent: the server-side agent signify-ts talks to&lt;br&gt;&lt;b&gt;KEL&lt;/b&gt; — Key Event Log: an AID&#39;s history of key-state changes (icp, rot...)&lt;br&gt;&lt;b&gt;TEL&lt;/b&gt; — Transaction Event Log: a registry&#39;s history of credential issuance/revocation (vcp, iss, rev...)&lt;br&gt;&lt;b&gt;OOBI&lt;/b&gt; — Out-Of-Band Introduction: a URL used to discover/resolve an AID&#39;s keys &amp; endpoint&lt;br&gt;&lt;b&gt;SAID&lt;/b&gt; — Self-Addressing Identifier: a content-hash identifier (credentials, schemas, edges)&lt;br&gt;&lt;b&gt;toad&lt;/b&gt; — Threshold Of Accountable Duplicity: witness receipts required before an event is accepted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1490" width="665" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="legendB" value="&lt;b&gt;Acronym Glossary (2/2) — Credentials &amp; vLEI Domain&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;ACDC&lt;/b&gt; — Authentic Chained Data Container: KERI&#39;s credential format&lt;br&gt;&lt;b&gt;IPEX&lt;/b&gt; — Issuance and Presentation Exchange: protocol for grant/admit (and apply/offer)&lt;br&gt;&lt;b&gt;exn&lt;/b&gt; — Exchange message: the peer-to-peer message type IPEX grant/admit are built on&lt;br&gt;&lt;b&gt;icp / iss&lt;/b&gt; — Inception event (first KEL event) / Issuance event (first TEL event)&lt;br&gt;&lt;b&gt;LEI&lt;/b&gt; — Legal Entity Identifier: the 20-character GLEIF code identifying an organization&lt;br&gt;&lt;b&gt;vLEI&lt;/b&gt; — verifiable LEI: the ACDC-based digital credential representing an LEI&lt;br&gt;&lt;b&gt;QVI&lt;/b&gt; — Qualified vLEI Issuer: GLEIF-accredited org authorized to issue vLEI credentials&lt;br&gt;&lt;b&gt;LE&lt;/b&gt; — Legal Entity: the organization holding the LEI/vLEI&lt;br&gt;&lt;b&gt;GEDA&lt;/b&gt; — GLEIF External Delegated AID: root-of-trust AID representing GLEIF in this demo&lt;br&gt;&lt;b&gt;OOR / ECR&lt;/b&gt; — Official Organizational Role / Engagement Context Role: person-level role credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="730" y="1490" width="665" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="e1a" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;endArrow=block;strokeColor=#666666;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="s1_person" target="s1_keri" edge="1">
