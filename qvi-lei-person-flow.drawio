                <mxCell id="hdr1d" value="1d. Holder Service (Person)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;holder/server.js + holder/keri.js, keriRole=&#39;person&#39; — same codebase as 1c, different role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
