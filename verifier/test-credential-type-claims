// End-to-end test: credential type, required claims and schema URL must tally.
// Needs issuer (3001), holder (3002) and verifier (3003) running.
//   API_KEY=<default api key> node verifier/test-credential-type-claims.mjs
const H  = {'Content-Type': 'application/json', 'x-api-client': process.env.API_CLIENT || 'default-client', 'x-api-key': process.env.API_KEY};
const I  = process.env.ISSUER_URL   || 'http://localhost:3001';
const HO = process.env.HOLDER_URL   || 'http://localhost:3002';
const V  = process.env.VERIFIER_URL || 'http://localhost:3003';

async function call(method, url, body) {
  const r = await fetch(url, {method, headers: H, body: body ? JSON.stringify(body) : undefined});
  const t = await r.text();
  let j; try { j = JSON.parse(t); } catch { j = t; }
  return {status: r.status, body: j};
}

let pass = 0, fail = 0;
function check(name, cond, info) {
  if (cond) { pass++; console.log(`  PASS  ${name}`); }
  else      { fail++; console.log(`  FAIL  ${name}\n        ${JSON.stringify(info).slice(0, 500)}`); }
}
const b64json = s => JSON.parse(Buffer.from(s, 'base64url').toString('utf8'));

// The schema from the requirement (no title → type comes from the slug)
const GRAD_SCHEMA = {
  type: 'object',
  properties: {
    fullname: {type: 'string'}, studentid: {type: 'string'}, programlevel: {type: 'string'},
    programname: {type: 'string'}, programcode: {type: 'string'}, campus: {type: 'string'},
    intake: {type: 'string'}, issuer: {type: 'string'}, classofaward: {type: 'string'},
    graduationdate: {type: 'string'}
  },
  required: [],
  additionalProperties: false
};
const SLUG = 'student-graduation';
const TYPE = 'StudentGraduationCredential';
const SUBJECT = {
  fullname: 'Ali Abu', studentid: 'S123', programlevel: 'Degree', programname: 'BSc Computer Science',
  programcode: 'CS01', campus: 'KL', intake: '2020', issuer: 'Uni X', classofaward: 'First Class',
  graduationdate: '2024-10-01'
};

console.log('\n== Setup');
const issuerDid = (await call('POST', `${I}/create`,  {name: 'University'})).body.did;
const holderDid = (await call('POST', `${HO}/create`, {name: 'Student'})).body.did;
await call('POST', `${V}/create`, {name: 'Employer'});
const reg = await call('POST', `${I}/schemas`, {slug: SLUG, version: '1.0.0', schemaJson: GRAD_SCHEMA});
check('register schema reports its credential type', reg.status === 201 && reg.body.credentialType === TYPE, reg.body);
const SCHEMA_URL = reg.body.schemaId;

console.log('\n== Issuance: credential type must tally with the schema');
const vcRes = await call('POST', `${I}/issue`, {holderDid, issuerDid, subject: SUBJECT, schemaSlug: SLUG});
check('type omitted → filled in from schema', vcRes.body.verifiableCredential?.type?.includes(TYPE), vcRes.body);
await call('POST', `${HO}/credentials`, {verifiableCredential: vcRes.body.verifiableCredential});

const wrongIssue = await call('POST', `${I}/issue`, {holderDid, issuerDid, subject: SUBJECT, schemaSlug: SLUG, credentialType: 'EmployeeBadgeCredential'});
check('wrong type for schema → 400 credential_type_schema_mismatch',
  wrongIssue.status === 400 && wrongIssue.body.error === 'credential_type_schema_mismatch', wrongIssue);

const sdRes = await call('POST', `${I}/issue`, {holderDid, issuerDid, subject: SUBJECT, schemaSlug: SLUG, credentialType: TYPE,
  format: 'sd-jwt', disclosableClaims: Object.keys(SUBJECT)});
const sdPayload = b64json(sdRes.body.sdJwt.split('.')[1]);
check('SD-JWT carries vct = credential type', sdPayload.vct === TYPE, sdPayload);
await call('POST', `${HO}/credentials`, {sdJwt: sdRes.body.sdJwt});

const wrongOffer = await call('POST', `${I}/oid4vci/offer`, {subject: SUBJECT, schemaSlug: SLUG, credentialType: 'EmployeeBadgeCredential'});
check('OID4VCI offer with wrong type → 400', wrongOffer.status === 400 && wrongOffer.body.error === 'credential_type_schema_mismatch', wrongOffer);

console.log('\n== Verifier request: accepted when type, claims and schema URL tally');
const ok1 = await call('POST', `${V}/oid4vp/request`, {credentialType: TYPE, requiredClaims: ['fullname', 'classofaward']});
check('type + claims in schema → 201', ok1.status === 201 && ok1.body.schema?.slug === SLUG, ok1.body);
const ok2 = await call('POST', `${V}/oid4vp/request`, {schemaUrl: SCHEMA_URL, requiredClaims: ['studentid']});
check('schema URL + claims → 201, type derived', ok2.status === 201 && ok2.body.credentialType === TYPE, ok2.body);
const ok3 = await call('POST', `${V}/oid4vp/request`, {credentialType: TYPE, schemaUrl: `${SCHEMA_URL}?version=1.0.0`, requiredClaims: ['fullname']});
check('schema URL with ?version= → 201', ok3.status === 201, ok3.body);
const jwt3 = await (await fetch(ok3.body.requestUri)).text();
const pd3  = b64json(jwt3.split('.')[1]).presentation_definition;
const schemaField = pd3.input_descriptors[0].constraints.fields.find(f => f.path[0].startsWith('$.credentialSchema'));
check('request carries the registered schema id (what credentials embed)', schemaField?.filter?.const === SCHEMA_URL, schemaField);
const ok4 = await call('POST', `${V}/oid4vp/request`, {credentialType: 'EmployeeBadgeCredential', requiredClaims: ['name', 'department']});
check('existing EmployeeBadge requests still work → 201', ok4.status === 201, ok4.body);
const ok5 = await call('POST', `${V}/oid4vp/request`, {});
check('empty body still works → 201', ok5.status === 201, ok5.body);

console.log('\n== Verifier request: rejected when they do not tally');
const r1 = await call('POST', `${V}/oid4vp/request`, {credentialType: TYPE, requiredClaims: ['fullname', 'salary']});
check('claim not in schema → 400 claims_not_in_schema',
  r1.status === 400 && r1.body.error === 'claims_not_in_schema' && r1.body.unknownClaims?.[0] === 'salary'
  && r1.body.allowedClaims?.includes('classofaward'), r1.body);
const r2 = await call('POST', `${V}/oid4vp/request`, {credentialType: 'EmployeeBadgeCredential', requiredClaims: ['classofaward']});
check('claim belongs to a different credential type → 400', r2.status === 400 && r2.body.error === 'claims_not_in_schema', r2.body);
const r3 = await call('POST', `${V}/oid4vp/request`, {credentialType: 'EmployeeBadgeCredential', schemaUrl: SCHEMA_URL, requiredClaims: ['fullname']});
check('type does not match schema URL → 400 credential_type_schema_mismatch',
  r3.status === 400 && r3.body.error === 'credential_type_schema_mismatch' && r3.body.expectedCredentialType === TYPE, r3.body);
const r4 = await call('POST', `${V}/oid4vp/request`, {schemaUrl: `${I}/schemas/student-graduaton`, requiredClaims: ['fullname']});
check('schema URL with wrong slug → 400 invalid_schema_url', r4.status === 400 && r4.body.error === 'invalid_schema_url', r4.body);
const r5 = await call('POST', `${V}/oid4vp/request`, {schemaUrl: `http://localhost:9999/schemas/${SLUG}`, requiredClaims: ['fullname']});
check('schema URL on wrong host → 400 invalid_schema_url', r5.status === 400 && r5.body.error === 'invalid_schema_url', r5.body);
const r6 = await call('POST', `${V}/oid4vp/request`, {schemaUrl: 'not a url', credentialType: TYPE});
check('schema URL that is not a URL → 400 invalid_schema_url', r6.status === 400 && r6.body.error === 'invalid_schema_url', r6.body);
const r7 = await call('POST', `${V}/oid4vp/request`, {schemaUrl: `${SCHEMA_URL}?version=9.9.9`, requiredClaims: ['fullname']});
check('schema URL with unknown version → 400 invalid_schema_url', r7.status === 400 && r7.body.error === 'invalid_schema_url', r7.body);
const r8 = await call('POST', `${V}/oid4vp/request`, {requiredClaims: ['fullname']});
check('claims without type or schema → 400 credential_type_required', r8.status === 400 && r8.body.error === 'credential_type_required', r8.body);
const r9 = await call('POST', `${V}/oid4vp/request`, {credentialType: 'NoSuchCredential', requiredClaims: ['fullname']});
check('unknown type with claims → 400 unknown_credential_type', r9.status === 400 && r9.body.error === 'unknown_credential_type', r9.body);
const r10 = await call('POST', `${V}/oid4vp/request`, {credentialType: TYPE, requiredClaims: ['fullname) || $.x']});
check('malformed claim name → 400 invalid_claim_name', r10.status === 400 && r10.body.error === 'invalid_claim_name', r10.body);
const r11 = await call('POST', `${V}/oid4vp/request`, {presentationDefinition: {id: 'x', input_descriptors: [{id: 'd', constraints: {fields: [
  {path: ['$.type'], filter: {type: 'array', contains: {const: TYPE}}},
  {path: ['$.credentialSubject.salary']}
]}}]}});
check('caller-supplied presentationDefinition is checked too → 400', r11.status === 400 && r11.body.error === 'claims_not_in_schema', r11.body);

console.log('\n== End to end (verifier-initiated)');
async function e2e(label, body, holderPath) {
  const req = await call('POST', `${V}/oid4vp/request`, body);
  const h   = await call('POST', `${HO}${holderPath}`, {requestUri: req.body.openid4vpUri});
  const res = (await call('GET', `${V}/oid4vp/result/${req.body.state}`)).body;
  check(label, res.verified === true, {request: req.status, holder: h.body, result: res});
}
await e2e('VC-LD with type + claims + schema URL → verified',
  {credentialType: TYPE, schemaUrl: SCHEMA_URL, credentialFormat: 'ldp_vc', requiredClaims: ['fullname', 'classofaward']}, '/oid4vp/initiate');

// SD-JWT: the holder cannot present /issue-d SD-JWTs yet (issuer key is in `cnf`,
// see notes), so this posts the presentation straight to response_uri the way a
// wallet would, to test the verifier's credential-type check on SD-JWTs.
{
  const req  = await call('POST', `${V}/oid4vp/request`, {credentialType: TYPE, credentialFormat: 'vc+sd-jwt', requiredClaims: ['fullname', 'studentid']});
  const keep = new Set(['fullname', 'studentid']);
  const [jwt, ...discs] = sdRes.body.sdJwt.split('~').filter(Boolean);
  const vpToken = [jwt, ...discs.filter(d => keep.has(b64json(d)[1]))].join('~') + '~';
  const post = await fetch(`${V}/oid4vp/response`, {method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'},
    body: new URLSearchParams({vp_token: vpToken, state: req.body.state})});
  const res = (await call('GET', `${V}/oid4vp/result/${req.body.state}`)).body;
  check('SD-JWT with type + claims → verified (type from vct)', res.verified === true && res.disclosedClaims?.fullname === 'Ali Abu',
    {post: post.status, result: res});
}

console.log('\n== Holder-initiated (wallet QR → verifier /scan)');
const creds  = (await call('GET', `${HO}/credentials`)).body.credentials;
const vcCred = creds.find(c => c.format === 'vc-ld' && c.vc?.type?.includes(TYPE));
const share  = await call('POST', `${HO}/oid4vp/share`, {credentialId: vcCred.id, mode: 'confirm'});
const badScan = await call('POST', `${V}/oid4vp/scan`, {qr: share.body.qrPayload, credentialType: TYPE, requiredClaims: ['salary']});
check('scan with claim not in schema → 400, nothing pushed to wallet',
  badScan.status === 400 && badScan.body.error === 'claims_not_in_schema' && badScan.body.state === null, badScan.body);
const shareStatus = (await call('GET', `${HO}/oid4vp/share/${share.body.shareId}/status`)).body;
check('rejected scan did not use up the holder QR', shareStatus.status === 'created', shareStatus);
const goodScan = await call('POST', `${V}/oid4vp/scan`, {qr: share.body.qrPayload, credentialType: TYPE, requiredClaims: ['fullname']});
check('scan with matching claims → 201 (pushed to wallet)', goodScan.status === 201, goodScan.body);

console.log(`\n${pass} passed, ${fail} failed`);
process.exit(fail ? 1 : 0);
